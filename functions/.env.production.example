# Production Functions runtime env example (do not commit real values)
# Copy to functions/.env.production.local for local preflight validation.

APP_ID=auditsim-pro-prod
APP_BASE_URL=https://yourdomain.com

# Stripe (required if billing is enabled for MVP)
STRIPE_SECRET_KEY=<sk_live_secret_key>
STRIPE_WEBHOOK_SECRET=<whsec_secret>
STRIPE_PRICE_INDIVIDUAL=<price_monthly>
STRIPE_PRICE_INDIVIDUAL_ANNUAL=<price_annual>

# Optional overrides (usually inferred by Firebase runtime)
# FIREBASE_STORAGE_BUCKET=<project-bucket>
# STORAGE_BUCKET=<project-bucket>
# GCLOUD_PROJECT=<firebase-project-id>
