# Production frontend env example (do not commit real values)
# Copy to .env.production.local and replace placeholders.

REACT_APP_FIREBASE_CONFIG='{"apiKey":"<apiKey>","authDomain":"<authDomain>","projectId":"<projectId>","storageBucket":"<storageBucket>","messagingSenderId":"<messagingSenderId>","appId":"<appId>"}'
REACT_APP_APP_ID=auditsim-pro-prod

# Optional if functions are deployed outside us-central1.
# REACT_APP_FUNCTIONS_REGION=us-central1

# Optional, but strongly recommended for public self-signup.
# REACT_APP_APPCHECK_SITE_KEY=<recaptcha-v3-site-key>

# Optional if you use the demo SURL entry flow in production.
# REACT_APP_DEMO_SURL_CASE_ID=<demo-case-id>

# Optional override if your storage bucket binding differs from Firebase config.
# REACT_APP_STORAGE_BUCKET_URL=gs://<bucket-name>
